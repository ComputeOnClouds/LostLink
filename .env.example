# Local Docker stack (docs/LOCAL.md). Copy to .env, or symlink an existing SoClaaS env
# file instead (its SOCLAAS_* variables are used as-is):  ln -s /path/to/soclaas.env .env
LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
LLM_API_KEY=

# Optional
# LLM_EMBED_MODEL=bge-m3
# LLM_VISION_MODEL=qwen3-vl:32b
# MATCH_THRESHOLD=0.85
# ONEMAP_EMAIL=
# ONEMAP_PASSWORD=
